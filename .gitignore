# ---- Secrets (never commit) ----
*.env
!*.env.example
.pulse.env

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
*.egg
build/
dist/

# ---- Node / frontend ----
node_modules
frontend/dist/
.vite/

# Built Vue app: `bench build --app pulse` (via package.json -> frontend) regenerates all
# of this on every deploy. www/pulse.html is part of the build output (it names the
# hashed asset files), so it is ignored too.
pulse/public/frontend/
pulse/www/pulse.html

# ---- MCP server ----
mcp/.venv/

# ---- Runtime / logs ----
*.log
dump.rdb
*.sqlite

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
